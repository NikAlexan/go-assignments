ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_pass
ORDERS_DB_NAME=orders_db
ORDERS_DB_PORT=5432

PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_pass
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_PORT=5433

ORDER_SERVICE_PORT=8080
PAYMENT_SERVICE_PORT=8081

PAYMENT_GRPC_PORT=50051
ORDER_GRPC_PORT=50052

# Redis
REDIS_ADDR=redis:6379
CACHE_TTL_SECONDS=300

# Notification provider: REAL (SMTP) or SIMULATED (mock with random failures)
PROVIDER_MODE=REAL

# Retry settings for notification worker
RETRY_MAX=5
RETRY_BASE_DELAY_MS=2000

# Rate limiter (requests per minute per IP)
RATE_LIMIT_RPM=10

# Gmail SMTP (optional — leave empty to disable real email sending)
SMTP_FROM=
SMTP_PASSWORD=
DEFAULT_CUSTOMER_EMAIL=
