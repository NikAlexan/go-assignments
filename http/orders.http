### Base URL
@baseUrl = http://localhost:8080

###
# Create order - should be Paid (amount <= $1000)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer_id": "cust-1",
  "item_name": "Laptop",
  "amount": 50000
}

###
# Create order with Idempotency-Key (duplicate request returns same order)
POST {{baseUrl}}/orders
Content-Type: application/json
Idempotency-Key: unique-key-001

{
  "customer_id": "cust-1",
  "item_name": "Laptop",
  "amount": 50000
}

###
# Create order - should be Failed (amount > $1000 -> Payment Service declines)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer_id": "cust-2",
  "item_name": "Enterprise Server",
  "amount": 150000
}

###
# Create order - validation error (amount = 0)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer_id": "cust-1",
  "item_name": "Free Item",
  "amount": 0
}

###
# Set the order ID from the response above
@orderId = REPLACE_WITH_ORDER_ID

###
# Get order by ID (1st call — cache miss, writes to Redis)
GET {{baseUrl}}/orders/{{orderId}}

###
# Get order by ID (2nd call — cache hit from Redis)
GET {{baseUrl}}/orders/{{orderId}}

###
# Get order - not found
GET {{baseUrl}}/orders/00000000-0000-0000-0000-000000000000

###
# Cancel a Paid order - should return 409 Conflict (cache NOT invalidated)
PATCH {{baseUrl}}/orders/{{orderId}}/cancel

###
@status = Paid
# Get orders by status
GET {{baseUrl}}/orders?status={{status}}

###
# Get payment stats (via Order Service → Payment Service gRPC)
GET {{baseUrl}}/payments/stats

### ─────────────────────────────────────────────────────────────
### Rate Limiter: 10 req/min per IP — 11th returns 429
### Test via curl:
###   for i in $(seq 1 11); do curl -s -o /dev/null -w "Request $i: %{http_code}\n" http://localhost:8080/orders/{{orderId}}; done
### ─────────────────────────────────────────────────────────────